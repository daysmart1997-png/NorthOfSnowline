# Godot caches; KEEP *.import sidecars, *.uid, project.godot and export_presets.cfg.
.godot/
.import/
.mono/
export_credentials.cfg
.godot-export-credentials/
/build/
/builds/
/dist/
/exports/
*.pck
*.exe
*.dll
*.dylib
*.so
*.app/
*.dmg

# Secrets and machine-local configuration. Only sanitized examples may be tracked.
.env
.env.*
!.env.example
!.env.*.example
*.env
*.local
secrets/
.secrets/
credentials.json
credentials.*.json
service-account*.json
service_account*.json
*service-account*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
.aws/
.ssh/
.npmrc
.pypirc
.netrc

# Reinstall dependencies per OS. Never copy Windows Python packages to macOS.
node_modules/
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage*
htmlcov/
/tools/audio_deps/

# Local reports, screenshots, saves and backups. Preserve the engine ignore marker.
/artifacts/*
!/artifacts/.gdignore
/savegame.json
/savegame.json.*
*.log
*.tmp
*.temp
*.bak
*.blend[0-9]*
*.blend@
*.swp
*.swo
*~
/source_art/audio/snow.7z
/tools/patch_v04.py

# OS/editor metadata and machine-specific launch shortcuts.
.DS_Store
._*
.AppleDouble/
.LSOverride
.Spotlight-V100/
.Trashes/
__MACOSX/
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.idea/
.vscode/
.vs/
